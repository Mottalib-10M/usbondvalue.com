---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to the publisher of BondWorth about a bond value, a rate, a state schedule or a source. E-mail only, no advice on your own bonds, nothing to sell or to open.';
---
<PageLayout title="Contact BondWorth: corrections to a value, a rate or a source" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>By e-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. No form and no newsletter: the site sells no bond, no account and no advice, so it has no reason to collect addresses.</p>
    <h2>Messages that help</h2>
    <ul>
      <li>A bond value that differs from what TreasuryDirect or the Savings Bond Calculator shows for the same bond and month: give the series, issue month, form, amount and the two values.</li>
      <li>A rate announcement (May 1 or November 1) or an auction result that the site has not picked up yet.</li>
      <li>A state income tax schedule that has changed, with the link to the state revenue department.</li>
      <li>Embedding the savings bond calculator on a library, credit union or blog site: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not look up bonds by serial number, search for lost bonds, recommend investments or tell anyone whether to cash a bond. For a missing or destroyed bond, the Treasury’s own forms apply; for your tax return, a tax professional or the IRS.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
